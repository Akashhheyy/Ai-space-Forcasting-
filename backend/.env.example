# Application
APP_NAME=Space Radiation Forecast API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/space_weather.db

# Scheduler (minutes)
DATA_FETCH_INTERVAL_MINUTES=5
PREDICTION_INTERVAL_MINUTES=5
MODEL_RETRAIN_INTERVAL_HOURS=24

# ML
MODEL_ARTIFACTS_DIR=artifacts/models
MIN_TRAINING_SAMPLES=200
FORECAST_HORIZONS_MINUTES=30,360,720

# NOAA API endpoints
NOAA_ELECTRON_FLUX_URL=https://services.swpc.noaa.gov/json/goes/primary/integral-electrons-1-day.json
NOAA_PROTON_FLUX_URL=https://services.swpc.noaa.gov/json/goes/primary/integral-protons-1-day.json
NOAA_SOLAR_WIND_URL=https://services.swpc.noaa.gov/products/solar-wind/plasma-1-day.json
NOAA_KP_INDEX_URL=https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json
NOAA_DST_INDEX_URL=https://services.swpc.noaa.gov/products/kyoto-dst.json

# Risk thresholds (composite radiation index 0-100)
RISK_LOW_THRESHOLD=35
RISK_MEDIUM_THRESHOLD=65

# Anomaly detection
ANOMALY_ZSCORE_THRESHOLD=3.0
